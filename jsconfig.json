{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "paths": {
    "@/*": ["./*"],
    "@app/*": ["./app/*"],
    "env": ["./env.mjs"],
    "@components/*": ["./components/*"],
    "@sections/*": ["./components/sections/*"],
    "@constants/*": ["./constants/*"],
    "@libs/*": ["./libs/*"],
    "@hooks/*": ["./hooks/*"],
    "@modules/*": ["./modules/*"],
    "@schemaTypes/*": ["./sanity/schemaTypes/*"]
    }
  },
  
  "include": [
    "./**/*",
    "sanity.config.js",
    "next.config.mjs",
    "env.mjs"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "__MACOSX",
    "public"
  ]
}
